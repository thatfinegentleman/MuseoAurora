@page "/visitors"
@using MuseoAurora.Models
@using MuseoAurora.Frontend.Services
@inject VisitorClient Client
@inject NavigationManager NavManager

<h3>Registro Visitatori (Biglietteria)</h3>

<button class="btn btn-primary mb-3" @onclick="GoToCreate">Nuovo Visitatore</button>

@if (visitors == null)
{
    <p><em>Caricamento...</em></p>
}
else if (!visitors.Any())
{
    <p>Nessun visitatore registrato.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Cognome</th>
                <th>Email</th>
                <th>Tipo Biglietto</th>
                <th>Prezzo (€)</th>
                <th>Azioni</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in visitors)
            {
                <tr>
                    <td>@v.FirstName</td>
                    <td>@v.LastName</td>
                    <td>@v.Email</td>
                    <td><span class="badge bg-info text-dark">@v.Name</span></td>
                    <td>@v.Price.ToString("0.00")</td>
                    <td>
                        <button class="btn btn-warning btn-sm" @onclick="() => GoToEdit(v.Id)">Modifica</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => Delete(v.Id)">Elimina</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Visitor>? visitors;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData() => visitors = await Client.GetVisitorsAsync();

    private void GoToCreate() => NavManager.NavigateTo("/visitors/create");

    private void GoToEdit(int id) => NavManager.NavigateTo($"/visitors/edit/{id}");

    private async Task Delete(int id)
    {
        await Client.DeleteVisitorAsync(id);
        await LoadData();
    }
}