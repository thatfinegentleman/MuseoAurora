@page "/exhibitions"
@using MuseoAurora.Models
@using MuseoAurora.Frontend.Services
@inject ExhibitionClient Client
@inject NavigationManager NavManager

<h3>Gestione Mostre</h3>

<button class="btn btn-primary mb-3" @onclick="GoToCreate">Nuova Mostra</button>

@if (exhibitions == null)
{
    <p><em>Caricamento...</em></p>
}
else if (!exhibitions.Any())
{
    <p>Nessuna mostra in programma.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Titolo</th>
                <th>Inizio</th>
                <th>Fine</th>
                <th>Stato</th>
                <th>Azioni</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ex in exhibitions)
            {
                <tr>
                    <td>@ex.Title</td>
                    <td>@ex.StartDate.ToShortDateString()</td>
                    <td>@ex.EndDate.ToShortDateString()</td>
                    <td>
                        <span class="badge @(ex.Status == "Attiva" ? "bg-success" : "bg-secondary")">
                            @ex.Status
                        </span>
                    </td>
                    <td>
                        <button class="btn btn-warning btn-sm" @onclick="() => GoToEdit(ex.Id)">Modifica</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => Delete(ex.Id)">Elimina</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Exhibition>? exhibitions;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData() => exhibitions = await Client.GetExhibitionsAsync();

    private void GoToCreate() => NavManager.NavigateTo("/exhibitions/create");

    private void GoToEdit(int id) => NavManager.NavigateTo($"/exhibitions/edit/{id}");

    private async Task Delete(int id)
    {
        await Client.DeleteExhibitionAsync(id);
        await LoadData();
    }
}