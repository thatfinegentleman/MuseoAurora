@page "/exhibitions/create"
@page "/exhibitions/edit/{Id:int}"
@using MuseoAurora.Models
@using MuseoAurora.Frontend.Services
@inject ExhibitionClient Client
@inject NavigationManager NavManager

<h3>@(Id.HasValue ? "Modifica Mostra" : "Pianifica Nuova Mostra")</h3>

@if (exhibition == null && Id.HasValue)
{
    <p><em>Caricamento dati...</em></p>
}
else
{
    <EditForm Model="exhibition" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Titolo Mostra</label>
            <InputText class="form-control" @bind-Value="exhibition.Title" />
        </div>

        <div class="mb-3">
            <label class="form-label">Descrizione</label>
            <InputTextArea class="form-control" @bind-Value="exhibition.Description" rows="3" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Data Inizio</label>
                <InputDate class="form-control" @bind-Value="exhibition.StartDate" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Data Fine</label>
                <InputDate class="form-control" @bind-Value="exhibition.EndDate" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Stato</label>
            <InputSelect class="form-select" @bind-Value="exhibition.Status">
                <option value="">Seleziona Stato...</option>
                <option value="Pianificata">Pianificata</option>
                <option value="Attiva">Attiva</option>
                <option value="Conclusa">Conclusa</option>
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">URL Locandina/Immagine</label>
            <InputText class="form-control" @bind-Value="exhibition.ImageUrl" />
        </div>

        <button type="submit" class="btn btn-success">Salva</button>
        <button type="button" class="btn btn-secondary" @onclick="Cancel">Annulla</button>
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }
    private Exhibition exhibition = new() { StartDate = DateTime.Today, EndDate = DateTime.Today.AddMonths(1) };

    protected override async Task OnParametersSetAsync()
    {
        if (Id.HasValue)
        {
            var res = await Client.GetExhibitionByIdAsync(Id.Value);
            if (res != null) exhibition = res;
        }
    }

    private async Task HandleSubmit()
    {
        if (Id.HasValue)
            await Client.UpdateExhibitionAsync(exhibition);
        else
            await Client.CreateExhibitionAsync(exhibition);

        NavManager.NavigateTo("/exhibitions");
    }

    private void Cancel() => NavManager.NavigateTo("/exhibitions");
}