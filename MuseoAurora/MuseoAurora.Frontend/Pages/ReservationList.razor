@page "/reservations"
@using MuseoAurora.Models
@using MuseoAurora.Frontend.Services
@inject ReservationClient Client
@inject NavigationManager NavManager

<h3>Gestione Prenotazioni (Visite Guidate)</h3>
<button class="btn btn-primary mb-3" @onclick="GoToCreate">Nuova Prenotazione</button>

@if (reservations == null)
{
    <p><em>Caricamento...</em></p>
}
else if (!reservations.Any())
{
    <p>Nessuna prenotazione registrata.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>ID Visitatore</th>
                <th>ID Visita Guidata</th>
                <th>Partecipanti</th>
                <th>Orario</th>
                <th>Stato</th>
                <th>Azioni</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in reservations)
            {
                <tr>
                    <td>@r.Id</td>
                    <td>@r.VisitorId</td>
                    <td>@r.GuidedTourId</td>
                    <td>@r.ParticipantsCount</td>
                    <td>@r.ReservationDate.ToString(@"hh\:mm")</td>
                    <td>
                        <span class="badge @(r.Status == "Confermata" ? "bg-success" : (r.Status == "Annullata" ? "bg-danger" : "bg-warning text-dark"))">
                            @r.Status
                        </span>
                    </td>
                    <td>
                        <button class="btn btn-warning btn-sm" @onclick="() => GoToEdit(r.Id)">Modifica</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => Delete(r.Id)">Elimina</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Reservation>? reservations;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData() => reservations = await Client.GetReservationsAsync();

    private void GoToCreate() => NavManager.NavigateTo("/reservations/create");

    private void GoToEdit(int id) => NavManager.NavigateTo($"/reservations/edit/{id}");

    private async Task Delete(int id)
    {
        await Client.DeleteReservationAsync(id);
        await LoadData();
    }
}