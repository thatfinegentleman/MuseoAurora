@page "/visitors/create"
@page "/visitors/edit/{Id:int}"
@using MuseoAurora.Models
@using MuseoAurora.Frontend.Services
@inject VisitorClient Client
@inject NavigationManager NavManager

<h3>@(Id.HasValue ? "Modifica Dati Visitatore" : "Registra Nuovo Visitatore")</h3>

@if (visitor == null && Id.HasValue)
{
    <p><em>Caricamento dati...</em></p>
}
else
{
    <EditForm Model="visitor" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Nome</label>
                <InputText class="form-control" @bind-Value="visitor.FirstName" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Cognome</label>
                <InputText class="form-control" @bind-Value="visitor.LastName" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Indirizzo Email</label>
            <InputText type="email" class="form-control" @bind-Value="visitor.Email" />
        </div>

        <hr class="my-4" />
        <h5>Dati Biglietto</h5>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Tipo Biglietto (es. Intero, Ridotto Studenti)</label>
                <InputText class="form-control" @bind-Value="visitor.Name" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Prezzo (€)</label>
                <InputNumber class="form-control" @bind-Value="visitor.Price" step="0.01" />
            </div>
        </div>

        <button type="submit" class="btn btn-success mt-3">Salva</button>
        <button type="button" class="btn btn-secondary mt-3" @onclick="Cancel">Annulla</button>
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }
    private Visitor visitor = new();

    protected override async Task OnParametersSetAsync()
    {
        if (Id.HasValue)
        {
            var res = await Client.GetVisitorByIdAsync(Id.Value);
            if (res != null) visitor = res;
        }
    }

    private async Task HandleSubmit()
    {
        if (Id.HasValue)
            await Client.UpdateVisitorAsync(visitor);
        else
            await Client.CreateVisitorAsync(visitor);

        NavManager.NavigateTo("/visitors");
    }

    private void Cancel() => NavManager.NavigateTo("/visitors");
}