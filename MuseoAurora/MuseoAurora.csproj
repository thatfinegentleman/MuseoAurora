      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MuseoAurora.Client\MuseoAurora.Client.csproj" />
    <ProjectReference Include="..\MuseoAurora.Models\MuseoAurora.Models.csproj" />
    <ProjectReference Include="..\MuseoAurora.Services\MuseoAurora.Services.csproj" />
  </ItemGroup>

</Project>
