<header class="navbar-brand-container">
    <a class="brand-wrapper" href="">
        <img src="images/logo.png" alt="Logo Museo" class="navbar-logo" />
        <span class="navbar-brand">MuseoAurora</span>
    </a>
    
    <div class="nav-controls">
        <nav>
            <ul class="nav-horizontal">
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="artworks">Opere</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="exhibitions">Mostre</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="guidedtours">Tour guidati</NavLink>
                </li>
                @if (!IsAdmin)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="contact">Contatti</NavLink>
                    </li>
                }
                @if (IsAdmin)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="reservations">Prenotazioni</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="tickets">Biglietti</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="tickettypes">Tipi di biglietti</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="visitors">Visitatori</NavLink>
                    </li>
                }
            </ul>
        </nav>

        <button class="btn-toggle-admin" @onclick="OnToggleClicked">
            @(IsAdmin ? "Modalità Admin" : "Modalità Visitatore")
        </button>
    </div>
</header>

@code {
    // dati dal MainLayout
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public EventCallback OnToggleClicked { get; set; }
}