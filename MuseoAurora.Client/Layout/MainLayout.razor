@inherits LayoutComponentBase

<CascadingValue Value="IsAdmin" Name="AdminState">
    <div class="page">
        <NavMenu IsAdmin="IsAdmin" OnToggleClicked="ToggleAdminMode" />

        <main>
            @Body
        </main>
    </div>
</CascadingValue>


@code {
    public bool IsAdmin { get; set; } = false;

    private void ToggleAdminMode()
    {
        IsAdmin = !IsAdmin;
        StateHasChanged();
    }
}


