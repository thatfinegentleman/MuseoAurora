@page "/tickets"
<PageTitle>Biglietti - Museo Civico Aurora</PageTitle>
<h3>Biglietti</h3>

<a href="/tickets/create" class="btn-brand btn-primary mb-3">Aggiungi biglietto</a>

@if (tickets == null)
{
    <p>Caricamento...</p>
}
else
{
    <table class="table-brand">
        <thead>
            <tr>
                <th>Visitatore</th>
                <th>Tipo di biglietto</th>
                <th>Data di acquisto</th>
                <th>Mostra</th>
                <th>Quantità</th>
                <th>Azioni</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in tickets)
            {
                <tr>
                    <td>@item.Visitor.FirstName @item.Visitor.LastName</td>
                    <td>@item.TicketType.Name</td>
                    <td>@item.PurchaseDate?.ToShortDateString()</td>
                    <td>@item.Exhibition.Title</td>
                    <td>@item.Quantity</td>
                    <td>
                        <a href="/tickets/edit/@item.Id" class="btn-brand btn-edit">Modifica</a>
                        <button class="btn-brand btn-delete" @onclick="() => Delete(item.Id)">Elimina</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}