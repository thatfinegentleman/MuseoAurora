@page "/tickets"

<h3>Biglietti</h3>

<a href="/tickets/create" class="btn-brand btn-primary mb-3">Aggiungi bigletto</a>

@if (tickets == null)
{
    <p>Caricamento...</p>
}
else
{
    <table class="table-brand">
        <thead>
            <tr>
                <th>Data di acquisto</th>
                <th>Quantità</th>
                <th>Prezzo totale</th>
                <th>Azioni</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in tickets)
            {
                <tr>
                    <td>@item.PurchaseDate?.ToShortDateString()</td>
                    <td>@item.Quantity</td>
                    <td>@item.TotalPrice</td>
                    <td>
                        <a href="/tickets/edit/@item.Id" class="btn-brand btn-edit">Modifica</a>
                        <button class="btn-brand btn-delete" @onclick="() => Delete(item.Id)">Elimina</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}