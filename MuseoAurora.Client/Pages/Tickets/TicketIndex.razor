@page "/tickets"

<h3>Tickets</h3>

<a href="/tickets/create" class="btn btn-primary mb-3">Add Ticket</a>

@if (tickets == null)
{
    <p>Loading...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Purchase Date</th>
                <th>Quantity</th>
                <th>Total Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in tickets)
            {
                <tr>
                    <td>@item.PurchaseDate?.ToShortDateString()</td>
                    <td>@item.Quantity</td>
                    <td>@item.TotalPrice</td>
                    <td>
                        <a href="/tickets/edit/@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}