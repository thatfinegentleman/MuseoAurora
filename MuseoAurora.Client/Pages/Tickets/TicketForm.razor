@page "/tickets/create"
@page "/tickets/edit/{Id:int}"
<PageTitle>@(Id.HasValue ? "Modifica biglietto" : "Crea biglietto") - Museo Civico Aurora</PageTitle>
<h3>@(Id.HasValue ? "Modifica biglietto" : "Crea biglietto")</h3>

<EditForm Model="ticket" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label>Visitatore</label>
        <InputSelect class="input-brand" @bind-Value="ticket.Visitor.Id">
            <option value="0">Seleziona un visitatore...</option>
            @foreach (var v in availableVisitors)
            {
                <option value="@v.Id">@v.LastName @v.FirstName</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label>Tipo di biglietto</label>
        <InputSelect class="input-brand" @bind-Value="ticket.TicketType.Id">
            <option value="0">Seleziona un tipo di biglietto...</option>
            @foreach (var t in availableTicketTypes)
            {
                <option value="@t.Id">@t.Name</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label>Mostra (opzionale)</label>
        <InputSelect class="input-brand" @bind-Value="ticket.Exhibition.Id">
            <option value="0">None...</option>
            @foreach (var e in availableExhibitions)
            {
                <option value="@e.Id">@e.Title</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label>Tour guidato (opzionale)</label>
        <InputSelect class="input-brand" @bind-Value="ticket.GuidedTour.Id">
            <option value="0">None...</option>
            @foreach (var gt in availableTours)
            {
                <option value="@gt.Id">@gt.Title</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label>Quantità</label>
        <InputNumber class="input-brand" @bind-Value="ticket.Quantity" />
    </div>

    <div class="mb-3">
        <label>Prezzo totale</label>
        <InputNumber class="input-brand" @bind-Value="ticket.TotalPrice" />
    </div>

    <button type="submit" class="btn-brand btn-save">Salva</button>
    @if (IsAdmin)
    {
        <a href="/tickets" class="btn-brand btn-cancel">Annulla</a>
    }
    else
    {
        <a href="/exhibitions" class="btn-brand btn-cancel">Annulla</a>
    }
</EditForm>