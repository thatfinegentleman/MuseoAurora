@page "/visitors/create"
@page "/visitors/edit/{Id:int}"

<h3>@(Id.HasValue ? "Edit Visitor" : "Create Visitor")</h3>

<EditForm Model="visitor" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label>First Name</label>
        <InputText class="input-brand" @bind-Value="visitor.FirstName" />
    </div>

    <div class="mb-3">
        <label>Last Name</label>
        <InputText class="input-brand" @bind-Value="visitor.LastName" />
    </div>

    <div class="mb-3">
        <label>Email</label>
        <InputText class="input-brand" @bind-Value="visitor.Email" />
    </div>

    <button type="submit" class="btn-brand btn-save">Save</button>
    <a href="/visitors" class="btn-brand btn-cancel">Cancel</a>
</EditForm>