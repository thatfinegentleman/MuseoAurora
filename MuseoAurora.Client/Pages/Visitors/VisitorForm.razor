@page "/visitors/create"
@page "/visitors/edit/{Id:int}"
<PageTitle>@(Id.HasValue ? "Modifica visitatore" : "Crea visitatore") - Museo Civico Aurora</PageTitle>
<h3>@(Id.HasValue ? "Modifica visitatore" : "Crea visitatore")</h3>

<EditForm Model="visitor" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label>Nome</label>
        <InputText class="input-brand" @bind-Value="visitor.FirstName" />
    </div>

    <div class="mb-3">
        <label>Cognome</label>
        <InputText class="input-brand" @bind-Value="visitor.LastName" />
    </div>

    <div class="mb-3">
        <label>Email</label>
        <InputText class="input-brand" @bind-Value="visitor.Email" />
    </div>

    <button type="submit" class="btn-brand btn-save">Salva</button>
    <a href="/visitors" class="btn-brand btn-cancel">Annulla</a>
</EditForm>