@page "/visitors"
<PageTitle>Visitatori - Museo Civico Aurora</PageTitle>
<h3>Visitatori</h3>

<a href="/visitors/create" class="btn-brand btn-primary mb-3">Aggiungi un visitatore</a>

@if (visitors == null)
{
    <p>Caricamento...</p>
}
else
{
    <table class="table-brand">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Cognome</th>
                <th>Email</th>
                <th>Azioni</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in visitors)
            {
                <tr>
                    <td>@item.FirstName</td>
                    <td>@item.LastName</td>
                    <td>@item.Email</td>
                    <td>
                        <a href="/visitors/edit/@item.Id" class="btn-brand btn-edit">Modifica</a>
                        <button class="btn-brand btn-delete" @onclick="() => Delete(item.Id)">Elimina</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}