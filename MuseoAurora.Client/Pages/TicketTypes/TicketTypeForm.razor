@page "/tickettypes/create"
@page "/tickettypes/edit/{Id:int}"

<h3>@(Id.HasValue ? "Modifica tipo di biglietto" : "Crea tipo di biglietto")</h3>

<EditForm Model="ticketType" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label>Nome</label>
        <InputText class="input-brand" @bind-Value="ticketType.Name" />
    </div>

    <div class="mb-3">
        <label>Prezzo</label>
        <InputNumber class="input-brand" @bind-Value="ticketType.Price" />
    </div>

    <button type="submit" 
        >Salva</button>
    <a href="/tickettypes" 
    >Annulla</a>
</EditForm>