@page "/tickettypes"
<PageTitle>Tipi di biglietto - Museo Civico Aurora</PageTitle>
<h3>Tipi di biglietto</h3>

<a href="/tickettypes/create" class="btn-brand btn-primary mb-3">Aggiungi tipo di biglietto</a>

@if (ticketTypes == null)
{
    <p>Caricamento...</p>
}
else
{
    <table class="table-brand">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Prezzo</th>
                <th>Azioni</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in ticketTypes)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Price</td>
                    <td>
                        <a href="/tickettypes/edit/@item.Id" class="btn-brand btn-edit">Modifica</a>
                        <button class="btn-brand btn-delete" @onclick="() => Delete(item.Id)">Elimina</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}