@page "/tickettypes"

<h3>Ticket Types</h3>

<a href="/tickettypes/create" class="btn-brand btn-primary mb-3">Add Ticket Type</a>

@if (ticketTypes == null)
{
    <p>Loading...</p>
}
else
{
    <table class="table-brand">
        <thead>
            <tr>
                <th>Name</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in ticketTypes)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Price</td>
                </tr>
            }
        </tbody>
    </table>
}