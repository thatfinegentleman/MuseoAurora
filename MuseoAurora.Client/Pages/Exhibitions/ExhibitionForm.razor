@page "/exhibitions/create"
@page "/exhibitions/edit/{Id:int}"
<PageTitle>@(Id.HasValue ? "Modifica mostra" : "Crea mostra") - Museo Civico Aurora</PageTitle>
<h3>@(Id.HasValue ? "Modifica mostra" : "Crea mostra")</h3>

<EditForm Model="exhibition" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label>Titolo</label>
        <InputText class="input-brand" @bind-Value="exhibition.Title" />
    </div>

    <div class="mb-3">
        <label>Descrizione</label>
        <InputTextArea class="input-brand" @bind-Value="exhibition.Description" />
    </div>

    <div class="mb-3">
        <label>Data d'inizio</label>
        <InputDate class="input-brand" @bind-Value="exhibition.StartDate" />
    </div>

    <div class="mb-3">
        <label>Data di fine</label>
        <InputDate class="input-brand" @bind-Value="exhibition.EndDate" />
    </div>

    <div class="mb-3">
        <label>Status</label>
        <InputText class="input-brand" @bind-Value="exhibition.Status" />
    </div>

    <div class="mb-3">
        <label>Url immagine (opzionale)</label>
        <InputText class="input-brand" @bind-Value="exhibition.ImageUrl" />
    </div>

    <button type="submit" class="btn-brand btn-save">Salva</button>
    <a href="/exhibitions" class="btn-brand btn-cancel">Annulla</a>
</EditForm>