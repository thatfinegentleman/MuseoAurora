@page "/exhibitions/create"
@page "/exhibitions/edit/{Id:int}"

<h3>@(Id.HasValue ? "Edit Exhibition" : "Create Exhibition")</h3>

<EditForm Model="exhibition" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label>Title</label>
        <InputText class="form-control" @bind-Value="exhibition.Title" />
    </div>

    <div class="mb-3">
        <label>Description</label>
        <InputTextArea class="form-control" @bind-Value="exhibition.Description" />
    </div>

    <div class="mb-3">
        <label>Start Date</label>
        <InputDate class="form-control" @bind-Value="exhibition.StartDate" />
    </div>

    <div class="mb-3">
        <label>End Date</label>
        <InputDate class="form-control" @bind-Value="exhibition.EndDate" />
    </div>

    <div class="mb-3">
        <label>Status</label>
        <InputText class="form-control" @bind-Value="exhibition.Status" />
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a href="/exhibitions" class="btn btn-secondary">Cancel</a>
</EditForm>