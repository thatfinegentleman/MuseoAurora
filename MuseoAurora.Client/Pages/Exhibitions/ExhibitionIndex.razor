@page "/exhibitions"

<h3>Exhibitions</h3>

<a href="/exhibitions/create" class="btn-brand btn-primary mb-3">Add Exhibition</a>

@if (exhibitions == null)
{
    <p>Loading...</p>
}
else
{
    <table class="table-brand">
        <thead>
            <tr>
                <th>Title</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in exhibitions)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.StartDate?.ToShortDateString()</td>
                    <td>@item.EndDate?.ToShortDateString()</td>
                    <td>@item.Status</td>
                    <td>
                        <a href="/exhibitions/edit/@item.Id" class="btn-brand btn-edit">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}