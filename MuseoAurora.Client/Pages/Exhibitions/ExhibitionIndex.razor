@page "/exhibitions"

<h3>Mostre</h3>

<a href="/exhibitions/create" class="btn-brand btn-primary mb-3">Aggiungi mostra</a>

@if (exhibitions == null)
{
    <p>Caricamento...</p>
}
else
{
    <table class="table-brand">
        <thead>
            <tr>
                <th>Titolo</th>
                <th>Data d'inizio</th>
                <th>Data di fine</th>
                <th>Status</th>
                <th>Azioni</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in exhibitions)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.StartDate?.ToShortDateString()</td>
                    <td>@item.EndDate?.ToShortDateString()</td>
                    <td>@item.Status</td>
                    <td>
                        <a href="/exhibitions/edit/@item.Id" class="btn-brand btn-edit">Modifica</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}