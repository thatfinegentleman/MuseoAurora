@page "/exhibitions"

<h3>Mostre</h3>

@if (IsAdmin)
{
    <a href="/exhibitions/create" class="btn-brand btn-primary mb-3">Aggiungi mostra</a>
}

@if (exhibitions == null)
{
    <p>Caricamento...</p>
}
else
{
    <table class="table-brand">
        <thead>
            <tr>
                <th>Titolo</th>
                <th>Data d'inizio</th>
                <th>Data di fine</th>
                <th>Status</th>
                @if (IsAdmin)
                {
                    <th>Azioni</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in exhibitions)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.StartDate?.ToShortDateString()</td>
                    <td>@item.EndDate?.ToShortDateString()</td>
                    <td>@item.Status</td>
                    @if (IsAdmin)
                    {
                        <td>
                            <a href="/exhibitions/edit/@item.Id" class="btn-brand btn-edit">Modifica</a>
                            <button class="btn-brand btn-delete" @onclick="() => Delete(item.Id)">Elimina</button>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}