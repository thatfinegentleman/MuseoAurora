@page "/exhibitions"

<PageTitle>Mostre - Museo Civico Aurora</PageTitle>

@if (!IsAdmin)
{
    <div class="hero-section hero-exhibitions">
        <h1 class="hero-title">Mostre</h1>
        <p class="hero-subtitle">Scopri gli eventi speciali e le mostre a tema attualmente in corso o in programmazione.</p>
    </div>
}
else
{
    <h3>Mostre</h3>
    <a href="/exhibitions/create" class="btn-brand btn-primary mb-3">Aggiungi mostra</a>
}

@if (exhibitions == null)
{
    <p>Caricamento...</p>
}
else
{
    @if (IsAdmin)
    {
        <table class="table-brand">
            <thead>
                <tr>
                    <th>Titolo</th>
                    <th>Data d'inizio</th>
                    <th>Data di fine</th>
                    <th>Status</th>
                    <th>Azioni</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in exhibitions)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.StartDate?.ToShortDateString()</td>
                        <td>@item.EndDate?.ToShortDateString()</td>
                        <td>@item.Status</td>
                        <td>
                            <a href="/exhibitions/edit/@item.Id" class="btn-brand btn-edit">Modifica</a>
                            <button class="btn-brand btn-delete" @onclick="() => Delete(item.Id)">Elimina</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="data-grid">
            @foreach (var item in exhibitions)
            {
                <div class="data-card">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" alt="@item.Title" class="card-img" />
                    }
                    <h4>@item.Title</h4>
                    <p><strong>Inizio:</strong> @item.StartDate?.ToShortDateString()</p>
                    <p><strong>Fine:</strong> @item.EndDate?.ToShortDateString()</p>
                    <p><strong>Stato:</strong> @item.Status</p>
                </div>
            }
        </div>
    }
}