@page "/reservations/create"
@page "/reservations/edit/{Id:int}"

<h3>@(Id.HasValue ? "Modifica prenotazione" : "Crea prenotazione")</h3>

<EditForm Model="reservation" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label>Visitatore</label>
        <InputSelect class="input-brand" @bind-Value="reservation.Visitor.Id">
            <option value="0">Seleziona un visitatore...</option>
            @foreach (var v in availableVisitors)
            {
                <option value="@v.Id">@v.LastName @v.FirstName</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label>Tour guidato</label>
        <InputSelect class="input-brand" @bind-Value="reservation.GuidedTour.Id">
            <option value="0">Seleziona un tour guidato...</option>
            @foreach (var gt in availableTours)
            {
                <option value="@gt.Id">@gt.Title</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label>Numero di partecipanti</label>
        <InputNumber class="input-brand" @bind-Value="reservation.ParticipantsCount" />
    </div>

    <div class="mb-3">
        <label>Data della prenotazione</label>
        <InputDate Type="InputDateType.DateTimeLocal" class="input-brand" @bind-Value="reservation.ReservationDate" />
    </div>

    <div class="mb-3">
        <label>Status</label>
        <InputText class="input-brand" @bind-Value="reservation.Status" />
    </div>

    <button type="submit" class="btn-brand btn-save">Salva</button>
    <a href="/reservations" class="btn-brand btn-cancel">Annulla</a>
</EditForm>