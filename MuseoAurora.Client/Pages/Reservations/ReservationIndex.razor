@page "/reservations"

<h3>Reservations</h3>

<a href="/reservations/create" class="btn-brand btn-primary mb-3">Add Reservation</a>

@if (reservations == null)
{
    <p>Loading...</p>
}
else
{
    <table class="table-brand">
        <thead>
            <tr>
                <th>Date</th>
                <th>Participants</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in reservations)
            {
                <tr>
                    <td>@item.ReservationDate?.ToShortDateString()</td>
                    <td>@item.ParticipantsCount</td>
                    <td>@item.Status</td>
                    <td>
                        <a href="/reservations/edit/@item.Id" class="btn-brand btn-edit">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}