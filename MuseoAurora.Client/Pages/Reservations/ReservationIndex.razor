@page "/reservations"
<PageTitle>Prenotazioni - Museo Civico Aurora</PageTitle>
<h3>Prenotazioni</h3>

<a href="/reservations/create" class="btn-brand btn-primary mb-3">Aggiungi prenotazione</a>

@if (reservations == null)
{
    <p>Caricamento...</p>
}
else
{
    <table class="table-brand">
        <thead>
            <tr>
                <th>Visitatore</th>
                <th>Visita guidata</th>
                <th>Data</th>
                <th>Partecipanti</th>
                <th>Status</th>
                @if (IsAdmin)
                {
                    <th>Azioni</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in reservations)
            {
                <tr>
                    <td>@item.Visitor.FirstName @item.Visitor.LastName</td>
                    <td>@item.GuidedTour.Title</td>
                    <td>@item.ReservationDate?.ToShortDateString()</td>
                    <td>@item.ParticipantsCount</td>
                    <td>@item.Status</td>
                    @if (IsAdmin)
                    {
                        <td>
                            <a href="/reservations/edit/@item.Id" class="btn-brand btn-edit">Modifica</a>
                            <button class="btn-brand btn-delete" @onclick="() => Delete(item.Id)">Elimina</button>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}