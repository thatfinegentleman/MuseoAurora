@page "/artworks/create"
@page "/artworks/edit/{Id:int}"

<h3>@(Id.HasValue ? "Edit Artwork" : "Create Artwork")</h3>

<EditForm Model="artwork" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label>Exhibition</label>
        <InputSelect class="form-select" @bind-Value="artwork.Exhibition.Id">
            <option value="0">Select Exhibition...</option>
            @foreach (var exhibition in availableExhibitions)
            {
                <option value="@exhibition.Id">@exhibition.Title</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label>Title</label>
        <InputText class="form-control" @bind-Value="artwork.Title" />
    </div>

    <div class="mb-3">
        <label>Author</label>
        <InputText class="form-control" @bind-Value="artwork.Author" />
    </div>

    <div class="mb-3">
        <label>Year</label>
        <InputNumber class="form-control" @bind-Value="artwork.Year" />
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a href="/artworks" class="btn btn-secondary">Cancel</a>
</EditForm>