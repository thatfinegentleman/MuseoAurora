@page "/artworks/create"
@page "/artworks/edit/{Id:int}"
<PageTitle>@(Id.HasValue ? "Modifica opera d'arte" : "Crea opera d'arte") - Museo Civico Aurora</PageTitle>
<h3>@(Id.HasValue ? "Modifica opera d'arte" : "Crea opera d'arte")</h3>

<EditForm Model="artwork" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label>Mostra</label>
        <InputSelect class="input-brand" @bind-Value="artwork.Exhibition.Id">
            <option value="0">Seleziona una mostra...</option>
            @foreach (var exhibition in availableExhibitions)
            {
                <option value="@exhibition.Id">@exhibition.Title</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label>Nome</label>
        <InputText class="input-brand" @bind-Value="artwork.Title" />
    </div>

    <div class="mb-3">
        <label>Autore</label>
        <InputText class="input-brand" @bind-Value="artwork.Author" />
    </div>

    <div class="mb-3">
        <label>Anno</label>
        <InputNumber class="input-brand" @bind-Value="artwork.Year" />
    </div>

    <button type="submit" class="btn-brand btn-save">Salva</button>
    <a href="/artworks" class="btn-brand btn-cancel">Annulla</a>
</EditForm>