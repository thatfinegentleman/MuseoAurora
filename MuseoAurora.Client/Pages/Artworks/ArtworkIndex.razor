@page "/artworks"

<h3>Opere d'arte</h3>

<a href="/artworks/create" class="btn-brand btn-primary mb-3">Aggiungi opera d'arte</a>

@if (artworks == null)
{
    <p>Caricamento...</p>
}
else
{
    <table class="table-brand">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Autore</th>
                <th>Anno</th>
                <th>Azioni</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in artworks)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Author</td>
                    <td>@item.Year</td>
                    <td>
                        <a href="/artworks/edit/@item.Id" class="btn-brand btn-edit">Modifica</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}