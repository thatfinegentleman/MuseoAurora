@page "/artworks"

<PageTitle>Opere d'arte - Museo Civico Aurora</PageTitle>

@if (!IsAdmin)
{
    <div class="hero-section hero-artworks">
        <h1 class="hero-title">La nostra collezione</h1>
        <p class="hero-subtitle">Esplora le opere permanenti esposte nelle nostre gallerie e scopri capolavori senza tempo.</p>
    </div>
}
else
{
    <h3>Opere d'arte</h3>
    <a href="/artworks/create" class="btn-brand btn-primary mb-3">Aggiungi opera d'arte</a>
}

@if (artworks == null)
{
    <p>Caricamento...</p>
}
else
{
    @if (IsAdmin)
    {
        <table class="table-brand">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Autore</th>
                    <th>Anno</th>
                    <th>Mostra</th>
                    <th>Azioni</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in artworks)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.Author</td>
                        <td>@item.Year</td>
                        <td>@item.Exhibition.Title</td>
                        <td>
                            <a href="/artworks/edit/@item.Id" class="btn-brand btn-edit">Modifica</a>
                            <button class="btn-brand btn-delete" @onclick="() => Delete(item.Id)">Elimina</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="data-grid">
            @foreach (var item in artworks)
            {
                <div class="data-card">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" alt="@item.Title" class="card-img" />
                    }
                    <h4>@item.Title</h4>
                    <p><strong>Autore:</strong> @item.Author</p>
                    <p><strong>Anno di realizzazione:</strong> @(item.Year?.ToString() ?? "Sconosciuto")</p>
                    <p><strong>Mostra:</strong> @item.Exhibition.Title</p>
                </div>
            }
        </div>
    }
}