@page "/guidedtours/create"
@page "/guidedtours/edit/{Id:int}"
<PageTitle>@(Id.HasValue ? "Modifica tour guidato" : "Crea tour guidato") - Museo Civico Aurora</PageTitle>
<h3>@(Id.HasValue ? "Modifica tour guidato" : "Crea tour guidato")</h3>

<EditForm Model="tour" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label>Mostra</label>
        <InputSelect class="input-brand"
            @bind-Value="tour.Exhibition.Id">
            <option value="0">Seleziona una mostra...</option>
            @foreach (var exhibition in availableExhibitions)
            {
                <option value="@exhibition.Id">@exhibition.Title</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label>Titolo</label>
        <InputText class="input-brand" @bind-Value="tour.Title" />
    </div>

    <div class="mb-3">
        <label>Data e ora d'inizio</label>
        <InputDate Type="InputDateType.DateTimeLocal" class="input-brand" @bind-Value="tour.StartTime" />
    </div>

    <div class="mb-3">
        <label>Durata in minuti</label>
        <InputNumber class="input-brand" @bind-Value="tour.DurationMinutes" />
    </div>

    <div class="mb-3">
        <label>Nome della guida</label>
        <InputText class="input-brand" @bind-Value="tour.GuideName" />
    </div>

    <div class="mb-3">
        <label>Numero massimo di partecipanti</label>
        <InputNumber class="input-brand" @bind-Value="tour.MaxParticipants" />
    </div>

    <button type="submit" class="btn-brand btn-save">Save</button>
    <a href="/guidedtours" class="btn-brand btn-cancel">Cancel</a>
</EditForm>