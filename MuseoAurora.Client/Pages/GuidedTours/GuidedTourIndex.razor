@page "/guidedtours"

<PageTitle>Tour guidati - Museo Civico Aurora</PageTitle>

@if (!IsAdmin)
{
    <div class="hero-section hero-tours">
        <h1 class="hero-title">Visite Guidate</h1>
        <p class="hero-subtitle">Vivi l'arte accompagnato dai nostri esperti. Esplora il calendario e prenota la tua visita.</p>
        <a href="/reservations/create" class="btn-brand btn-primary" style="background-color: var(--brand-light); color: var(--brand-terracotta);">Prenota un tour</a>
    </div>
}
else
{
    <h3>Tour guidati</h3>
    <a href="/guidedtours/create" class="btn-brand btn-primary mb-3">Aggiungi tour guidato</a>
}

@if (tours == null)
{
    <p>Caricamento...</p>
}
else
{
    @if (IsAdmin)
    {
        <table class="table-brand">
            <thead>
                <tr>
                    <th>Titolo</th>
                    <th>Ora d'inizio</th>
                    <th>Durata</th>
                    <th>Nome della guida</th>
                    <th>Mostra</th>
                    <th>Azioni</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in tours)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.StartTime</td>
                        <td>@item.DurationMinutes min</td>
                        <td>@item.Exhibition.Title</td>
                        <td>@item.GuideName</td>
                        <td>
                            <a href="/guidedtours/edit/@item.Id" class="btn-brand btn-edit">Modifica</a>
                            <button class="btn-brand btn-delete" @onclick="() => Delete(item.Id)">Elimina</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="data-grid">
            @foreach (var item in tours)
            {
                <div class="data-card">
                    <h4>@item.Title</h4>
                    <p><strong>Orario:</strong> @item.StartTime</p>
                    <p><strong>Durata:</strong> @item.DurationMinutes minuti</p>
                    <p><strong>Mostra:</strong> @item.Exhibition.Title</p>
                    <p><strong>Guida:</strong> @item.GuideName</p>
                </div>
            }
        </div>
    }
}