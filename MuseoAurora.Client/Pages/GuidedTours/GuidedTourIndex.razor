@page "/guidedtours"

<h3>Tour guidati</h3>

<a href="/guidedtours/create" class="btn-brand btn-primary mb-3">Aggiungi tour guidato</a>

@if (tours == null)
{
    <p>Caricamento...</p>
}
else
{
    <table class="table-brand">
        <thead>
            <tr>
                <th>Titolo</th>
                <th>Ora d'inizio</th>
                <th>Durata</th>
                <th>Nome della guida</th>
                <th>Azioni</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in tours)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.StartTime</td>
                    <td>@item.DurationMinutes min</td>
                    <td>@item.GuideName</td>
                    <td>
                        <a href="/guidedtours/edit/@item.Id" class="btn-brand btn-edit">Modifica</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}